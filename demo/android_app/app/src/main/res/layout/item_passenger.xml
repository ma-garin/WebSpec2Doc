<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pax_item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/pax_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="搭乗者情報"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="姓（カナ）" />

        <EditText
            android:id="@+id/pax_last_kana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ヤマダ"
            android:inputType="text"
            android:maxLength="20" />

        <TextView
            android:id="@+id/pax_last_kana_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="名（カナ）" />

        <EditText
            android:id="@+id/pax_first_kana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="タロウ"
            android:inputType="text"
            android:maxLength="20" />

        <TextView
            android:id="@+id/pax_first_kana_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="生年月日" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/pax_birth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="yyyy-MM-dd"
                android:inputType="date" />

            <Button
                android:id="@+id/pax_birth_pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="選択" />
        </LinearLayout>

        <TextView
            android:id="@+id/pax_birth_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="性別" />

        <RadioGroup
            android:id="@+id/pax_gender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/pax_gender_male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="男性" />

            <RadioButton
                android:id="@+id/pax_gender_female"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="女性" />

            <RadioButton
                android:id="@+id/pax_gender_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="その他" />
        </RadioGroup>

        <TextView
            android:id="@+id/pax_gender_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pax_phone_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="電話番号" />

        <EditText
            android:id="@+id/pax_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="09012345678"
            android:inputType="phone"
            android:maxLength="11" />

        <TextView
            android:id="@+id/pax_phone_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pax_email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="メールアドレス" />

        <EditText
            android:id="@+id/pax_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="example@mail.com"
            android:inputType="textEmailAddress" />

        <TextView
            android:id="@+id/pax_email_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
