 "cases": [
  {
   "title": "請求一覧の並び順の変更",
   "change_text": "査定画面の請求一覧の並び順を、審査期限の近い順から、請求日の古い順に変える。",
   "expected_items": [
    "SCR-520"
   ]
  },
  {
   "title": "引落不能契約の並び順",
   "change_text": "引落不能になった契約を、失効予定の一覧でも引落結果の一覧でも、契約番号の昇順に並べる。",
   "expected_items": [
    "SCR-504",
    "SCR-505"
   ]
  },
  {
   "title": "保険期間の延長",
   "change_text": "個人向け医療保険の保険期間を、1年から3年に延ばす。",
   "expected_items": [
    "REQ-301",
    "DSN-301",
    "DSN-307",
    "DSN-313",
    "SCR-506",
    "SCR-508",
    "TC-302",
    "TC-310",
    "TC-311",
    "TC-319"
   ]
  },
  {
   "title": "郵送通知の簡易書留化",
   "change_text": "郵送で送る通知は、すべて簡易書留に切り替える。電子メールの扱いは変えない。",
   "expected_items": [
    "REQ-317",
    "REQ-311",
    "DSN-315",
    "DSN-306",
    "DSN-307",
    "DSN-312",
    "TC-324",
    "TC-318"
   ]
  },
  {
   "title": "保険金の支払の前倒し",
   "change_text": "保険金の支払いを早め、承認から3営業日以内に振り込むようにする。",
   "expected_items": [
    "REQ-311",
    "DSN-312",
    "SCR-525",
    "TC-318"
   ]
  },
  {
   "title": "契約者の年齢上限の引き下げ",
   "change_text": "契約者の年齢の上限を、満75歳から満70歳に下げる。",
   "expected_items": [
    "REQ-302",
    "DSN-302",
    "TC-303"
   ]
  },
  {
   "title": "被保険者の年齢上限の引き上げ",
   "change_text": "被保険者の年齢の上限を、満80歳から満85歳に引き上げる。",
   "expected_items": [
    "REQ-302",
    "DSN-302",
    "TC-304"
   ]
  },
  {
   "title": "失効基準の変更",
   "change_text": "口座から引き落とせなかった契約を失効にする基準を、2か月連続から3か月連続に変える。再請求は翌月に行う点は変えない。",
   "expected_items": [
    "REQ-305",
    "DSN-306",
    "SCR-505",
    "TC-309"
   ]
  },
  {
   "title": "解約返戻金の対象限定",
   "change_text": "解約返戻金は、年払の契約にだけ出す。月払の契約には返戻金を出さない。",
   "expected_items": [
    "REQ-312",
    "DSN-313",
    "SCR-508",
    "TC-319"
   ]
  },
  {
   "title": "役員承認の金額基準の引き上げ",
