{
  "permissions": {
    "allow": [
      "Bash(python scripts/quality_harness.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-gates.py\"",
            "timeout": 10,
            "statusMessage": "ゲート実行の要否を確認中"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/statusline.py\"",
    "refreshInterval": 5,
    "padding": 2
  }
}
