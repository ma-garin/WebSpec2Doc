{
  "name": "default",
  "version": "1.0.0",
  "profile": "standard",
  "params": {
    "ambiguous_terms": [
      {"term": "適切に", "pattern": "適切に"},
      {"term": "適宜", "pattern": "適宜"},
      {"term": "必要に応じて", "pattern": "必要に応じて"},
      {"term": "速やかに", "pattern": "速やかに", "numeric_exempt": true},
      {"term": "可能な限り", "pattern": "可能な限り"},
      {"term": "原則として", "pattern": "原則として"},
      {"term": "基本的に", "pattern": "基本的に"},
      {"term": "十分に", "pattern": "十分に", "numeric_exempt": true},
      {"term": "容易に", "pattern": "容易に"},
      {"term": "一定", "pattern": "一定", "numeric_exempt": true},
      {"term": "所定", "pattern": "所定", "numeric_exempt": true},
      {"term": "通常", "pattern": "通常", "numeric_exempt": true,
       "follow_exempt": ["画面", "モード", "ユーザー", "会員", "料金", "価格", "配送", "運用", "プラン", "ログイン"]},
      {"term": "など", "pattern": "など"},
      {"term": "等", "pattern": "(?<![同均平対高優特初上下中])等(?![しいく])"},
      {"term": "その他必要な", "pattern": "その他(?:必要|適切|適当|所要|相当)な"},
      {"term": "場合によって", "pattern": "場合(?:によって|により)(?:は)?"},
      {"term": "状況に応じ", "pattern": "(?:状況|状態|内容|程度)に応じ(?:て|た)"},
      {"term": "できる限り", "pattern": "(?:できる|出来る)限り|極力"},
      {"term": "随時", "pattern": "随時|適時"},
      {"term": "ある程度", "pattern": "ある程度|概ね|おおむね"},
      {"term": "適当", "pattern": "適当(?:に|な)"},
      {"term": "なるべく", "pattern": "なるべく"},
      {"term": "できるだけ", "pattern": "できるだけ"},
      {"term": "appropriate", "pattern": "\\bappropriate(?:ly)?\\b", "ignore_case": true},
      {"term": "as needed", "pattern": "\\bas needed\\b", "ignore_case": true},
      {"term": "quickly", "pattern": "\\bquickly\\b", "ignore_case": true, "numeric_exempt": true},
      {"term": "normally", "pattern": "\\bnormally\\b", "ignore_case": true},
      {"term": "sufficient", "pattern": "\\bsufficient(?:ly)?\\b", "ignore_case": true, "numeric_exempt": true},
      {"term": "etc.", "pattern": "\\betc\\.", "ignore_case": true},
      {"term": "reasonable", "pattern": "\\breasonabl[ey]\\b", "ignore_case": true},
      {"term": "where possible", "pattern": "\\bwhere possible\\b", "ignore_case": true}
    ],
    "numeric_window": 12,
    "tbd_patterns": ["\\bTBD\\b", "\\bTODO\\b", "\\bFIXME\\b", "後で決定", "別途検討", "未定(?!義)", "要調整", "調整中", "未確定"],
    "placeholder_patterns": [
      {"label": "XXX", "pattern": "X{3,}"},
      {"label": "9999", "pattern": "(?<![0-9])9{4,}(?![0-9])", "exempt_after": ["-12-31", "/12/31", "年12月31日"]},
      {"label": "仮", "pattern": "仮(?:の|値|置き|設定|数値|金額|定め)"},
      {"label": "暫定", "pattern": "暫定"},
      {"label": "サンプル値", "pattern": "サンプル値"}
    ],
    "id_prefixes": ["REQ", "FR", "NFR", "API", "SCR", "TC", "BR", "SEC", "DB", "UC"],
    "ref_section_patterns": ["(?<![A-Za-z0-9._\\-紙録添])(\\d+(?:\\.\\d+)*)\\s*(?:章|節|項)?\\s*(?:を|も|の)?\\s*参照"],
    "ref_appendix_pattern": "(?:別紙|付録|別添|添付資料|Appendix\\s*)\\s*([A-ZＡ-Ｚ0-9０-９]+)",
    "term_groups": [
      ["顧客", "利用者", "ユーザー?", "会員"],
      ["ログイン", "サインイン"],
      ["削除", "消去"],
      ["キャンセル", "取消", "取り消し"]
    ],
    "term_define_markers": ["とは", "を指す", "をいう"],
    "units": {
      "秒": ["time", 1], "分": ["time", 60], "時間": ["time", 3600], "日": ["time", 86400],
      "ms": ["time", 0.001], "ミリ秒": ["time", 0.001],
      "件": ["count", 1], "回": ["count", 1], "人": ["count", 1], "文字": ["count", 1], "桁": ["count", 1],
      "KB": ["size", 1024], "MB": ["size", 1048576], "GB": ["size", 1073741824],
      "%": ["ratio", 1], "％": ["ratio", 1], "円": ["money", 1], "px": ["px", 1], "個": ["count", 1], "歳": ["age", 1], "才": ["age", 1]
    },
    "unit_required_context": ["応答時間", "タイムアウト", "待機時間", "処理時間", "有効期限", "保持期間", "間隔", "容量", "サイズ", "遅延"],
    "unit_missing_follow": "(?:以内|以下|以上|未満|を超|超|まで|程度|とする|である|です|\\s*\\||\\s*$|\\s*[。、,])",
    "known_acronyms": ["Mbps", "Kbps", "Gbps", "Tbps", "Hz", "API", "URL", "ID", "UI", "UX", "HTTP", "HTTPS", "CSV", "PDF", "JSON", "XML", "SQL", "OK", "NG", "PC", "OS", "DB", "CPU", "RAM", "HTML", "CSS", "TLS", "SSL", "ISO", "JIS", "IEEE", "UTF", "AM", "PM", "MFA", "SMS", "QR", "AI"],
    "required_items": [],
    "required_items_by_type": [
      {"type": "認証", "min_triggers": 4, "triggers": ["認証", "ログイン", "サインイン", "パスワード", "ログアウト", "セッション", "多要素"],
       "items": [["ロック", "ロックアウト", "試行回数"], ["有効期限", "タイムアウト", "失効"], ["パスワード再設定", "パスワードリセット", "再発行"], ["エラー表示", "エラーメッセージ", "失敗した場合"]]},
      {"type": "アップロード", "min_triggers": 4, "triggers": ["アップロード", "添付", "ファイル形式", "拡張子", "取り込み", "インポート"],
       "items": [["サイズ上限", "容量上限", "最大サイズ", "MB以下", "MBまで"], ["拡張子", "ファイル形式", "対応形式"], ["エラー表示", "エラーメッセージ", "失敗した場合"], ["ウイルス", "マルウェア", "スキャン"]]},
      {"type": "決済", "min_triggers": 4, "triggers": ["決済", "支払", "クレジット", "請求", "返金", "課金"],
       "items": [["返金", "払い戻し"], ["決済失敗", "失敗した場合", "エラー"], ["二重", "重複", "冪等"], ["領収", "明細", "請求書"]]}
    ]
  },
  "rules": [
    {"rule_id": "AMB-001", "name": "曖昧語", "description": "検証できない曖昧な表現が使われていないか", "severity": "medium", "scope": "document", "detector": "ambiguity", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "曖昧な語は人によって解釈が分かれ、テスト条件に落とせない", "how_to_fix": "数値・条件・一覧など検証できる表現に置き換える"},
    {"rule_id": "TBD-001", "name": "未決事項", "description": "TBD/TODO など未決のまま残っていないか", "severity": "high", "scope": "document", "detector": "tbd", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "未決のまま設計・テストに進むと手戻りになる", "how_to_fix": "決定者と期限を決めて確定するか、課題票へ移す"},
    {"rule_id": "PLH-001", "name": "仮置き値", "description": "XXX・9999・仮・暫定などの仮値が残っていないか", "severity": "medium", "scope": "document", "detector": "placeholder", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "仮値は期待結果を決められず、そのまま出荷される恐れがある", "how_to_fix": "確定値に置き換えるか、確定条件と期限を明記する"},
    {"rule_id": "REF-001", "name": "参照切れ", "description": "参照先の章・別紙・IDが存在するか", "severity": "high", "scope": "document", "detector": "broken_ref", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "参照先が無いと要件の根拠・条件をたどれない", "how_to_fix": "参照先を追記するか、正しい参照先に直す"},
    {"rule_id": "ID-001", "name": "ID重複", "description": "同じIDが複数の項目で定義されていないか", "severity": "high", "scope": "document", "detector": "id_duplicate", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "IDが重複するとテストや変更の追跡先が一意に決まらない", "how_to_fix": "どちらかのIDを採番し直す"},
    {"rule_id": "ID-002", "name": "ID欠番", "description": "連番の途中が抜けていないか", "severity": "low", "scope": "document", "detector": "id_gap", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "欠番は削除・記載漏れのどちらか分からず追跡を迷わせる", "how_to_fix": "欠番の理由を注記するか、抜けた項目を補う"},
    {"rule_id": "ID-003", "name": "ID形式不一致", "description": "IDの表記（区切り・桁数・大文字小文字）が揃っているか", "severity": "low", "scope": "document", "detector": "id_format", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "形式が揺れると検索・機械照合が漏れる", "how_to_fix": "文書内で最も多い形式（例 REQ-001）に揃える"},
    {"rule_id": "ID-004", "name": "孤立ID", "description": "定義されたIDがどこからも参照されていないか", "severity": "info", "scope": "corpus", "detector": "id_orphan", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "参照されない要件は設計・テストへ落ちていない可能性がある", "how_to_fix": "対応する設計・テストを紐付けるか、不要なら削除理由を残す"},
    {"rule_id": "TERM-001", "name": "用語の表記揺れ候補", "description": "同じ意味かもしれない語が混在していないか", "severity": "low", "scope": "document", "detector": "term_variance", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "別の語が同じ対象を指すなら読み手が別物と誤解する", "how_to_fix": "同義なら用語を統一、別物なら用語定義で区別を明記する"},
    {"rule_id": "NUM-001", "name": "単位なしの数値", "description": "時間・容量などの数値に単位があるか", "severity": "medium", "scope": "document", "detector": "number_unit", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "単位が無いと合否の閾値が決まらない", "how_to_fix": "単位（秒・分・MB など）を付ける"},
    {"rule_id": "NUM-002", "name": "範囲の逆転", "description": "「A〜B」「A以上B以下」で A が B より大きくないか", "severity": "high", "scope": "document", "detector": "number_range", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "範囲が逆だと境界値テストの期待が成立しない", "how_to_fix": "上限・下限を確認して正しい順にする"},
    {"rule_id": "REQ-ITEMS", "name": "必須項目", "description": "組織で必須とした項目が文書にあるか", "severity": "medium", "scope": "document", "detector": "required_items", "enabled": true, "profile": ["standard", "strict"], "version": "1.0.0",
     "why": "必須項目が無い文書はレビューの前提を満たさない", "how_to_fix": "不足している項目の節を追加する"}
  ]
}
