<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="お支払い"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/payment_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/payment_coupon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="クーポンコード"
                    android:inputType="textCapCharacters" />

                <Button
                    android:id="@+id/payment_coupon_apply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="適用" />
            </LinearLayout>

            <TextView
                android:id="@+id/payment_coupon_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/payment_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/payment_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="お支払い方法"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/payment_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/payment_method_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="クレジットカード" />

                <RadioButton
                    android:id="@+id/payment_method_conv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="コンビニ払い" />

                <RadioButton
                    android:id="@+id/payment_method_bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="銀行振込" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/payment_card_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="カード番号" />

                <EditText
                    android:id="@+id/payment_card_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="4242424242424242"
                    android:inputType="number"
                    android:maxLength="16" />

                <TextView
                    android:id="@+id/payment_card_number_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="有効期限（MM/YY）" />

                <EditText
                    android:id="@+id/payment_card_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="12/28"
                    android:inputType="text"
                    android:maxLength="5" />

                <TextView
                    android:id="@+id/payment_card_expiry_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="セキュリティコード" />

                <EditText
                    android:id="@+id/payment_card_cvv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="123"
                    android:inputType="number"
                    android:maxLength="3" />

                <TextView
                    android:id="@+id/payment_card_cvv_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="カード名義（英大文字）" />

                <EditText
                    android:id="@+id/payment_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="TARO YAMADA"
                    android:inputType="textCapCharacters" />

                <TextView
                    android:id="@+id/payment_card_name_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/payment_conv_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="コンビニを選択" />

                <Spinner
                    android:id="@+id/payment_conv_store"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/payment_bank_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="振込先情報は予約確定後にメールでお送りします。" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/payment_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="予約を確定" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
