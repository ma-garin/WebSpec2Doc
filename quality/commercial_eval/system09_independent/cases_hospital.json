 "cases": [
  {
   "title": "予約受付開始の前倒し",
   "change_text": "予約を受け付け始める時期を、診察日の30日前から60日前に早める。",
   "expected_items": [
    "REQ-203",
    "DSN-203",
    "SCR-403",
    "TC-204"
   ]
  },
  {
   "title": "変更取消の締切の延長",
   "change_text": "オンラインで予約を変更・取消できる期限を、前日17:00から当日朝8時までに延ばす。",
   "expected_items": [
    "REQ-206",
    "DSN-207",
    "SCR-408",
    "TC-209"
   ]
  },
  {
   "title": "予約受付締切の変更",
   "change_text": "予約の受付終了を前日17:00から診察開始の2時間前に変更する。",
   "expected_items": [
    "REQ-203",
    "DSN-203",
    "SCR-403",
    "TC-205"
   ]
  },
  {
   "title": "症状入力欄の追加",
   "change_text": "予約時に、患者が症状を入力する欄を追加する。電話予約の代行入力でも同じ欄を使う。",
   "expected_items": [
    "REQ-201",
    "DSN-204",
    "SCR-407",
    "SCR-453"
   ]
  },
  {
   "title": "無断キャンセル停止の厳格化",
   "change_text": "無断キャンセルが2回続いたらオンライン予約を60日間止めるようにする（現在は3回で90日）。",
   "expected_items": [
    "REQ-207",
    "DSN-208",
    "SCR-409",
    "TC-210"
   ]
  },
  {
   "title": "受付職員へのマスタ権限付与",
   "change_text": "診療科や医師の登録内容を、管理者だけでなく受付職員も変更できるようにする。",
   "expected_items": [
    "REQ-213",
    "DSN-214",
    "SCR-456",
    "TC-216"
   ]
  },
  {
   "title": "会計連携の一括送信化",
   "change_text": "会計システムへの送信を、診察が終わるたびではなく、夜間に1日分まとめて送る方式に変える。",
   "expected_items": [
    "REQ-214",
    "DSN-215",
    "SCR-458",
    "TC-217"
   ]
  },
  {
   "title": "選定療養費の改定",
   "change_text": "紹介状がない初診患者にかかる費用を5,500円から7,700円に改定する。",
   "expected_items": [
    "REQ-205",
    "DSN-206",
    "SCR-404",
    "TC-208"
   ]
  },
  {
   "title": "SMS通知の廃止",
   "change_text": "前日のSMS通知をやめて、確認メールだけにする。",
   "expected_items": [
    "REQ-208",
    "DSN-210",
    "TC-212"
   ]
  },
  {
   "title": "小児科案内文言の変更",
   "change_text": "SCR-406 の表示文言を「小児科は15歳以下の方のみです」から「小児科は15歳以下の患者さまのみご予約いただけます」に変える。",
   "expected_items": [
    "SCR-406"
   ]
  },
  {
   "title": "昼休みの時間変更",
   "change_text": "昼休みで予約を取れない時間を、12:00から13:00ではなく12:30から13:30にする。",
   "expected_items": [
    "REQ-202",
    "DSN-202",
    "TC-202"
   ]
  },
  {
   "title": "予約枠の細分化",
   "change_text": "1枠の長さを15分から10分に短くする。",
   "expected_items": [
    "REQ-202",
    "REQ-210",
    "DSN-202",
    "DSN-212",
    "SCR-402",
    "SCR-410",
    "SCR-454",
    "TC-202",
    "TC-203",
    "TC-214"
   ]
  },
  {
   "title": "小児科の年齢範囲の拡大",
   "change_text": "小児科で予約できる患者を15歳以下から18歳以下に広げる。",
   "expected_items": [
    "REQ-211",
    "DSN-209",
    "SCR-406",
    "TC-211"
   ]
  },
  {
   "title": "初診枠の縮小",
   "change_text": "初診の患者を受けられる数を、医師1人につき1日5枠から3枠に減らす。",
   "expected_items": [
    "REQ-212",
    "DSN-213",
    "SCR-402",
    "SCR-457",
    "TC-215"
   ]
  }
