{
  "feature_id": "login",
  "name": "ログイン / セッション",
  "risk_level": "critical",
  "status": "implemented",
  "ui_files": [
    "templates/partials/view-generate.html",
    "static/js/wizard.js"
  ],
  "route_files": [
    "web/routes/login.py"
  ],
  "core_files": [
    "src/crawler/auto_login.py",
    "src/analyzer/login_wall.py",
    "src/crawler/auth_recorder.py",
    "src/crawler/auth.py",
    "src/crawler/login_signal.py",
    "src/crawler/session_guard.py"
  ],
  "symbols": [
    "submit_login_simple",
    "detect_login_wall",
    "record_auth_session",
    "verify_auth_state"
  ],
  "outputs": [
    "auth.json",
    "login wall status",
    "login record status (.login_status.json)"
  ],
  "persistence": [
    "output/{domain}/auth.json",
    "output/{domain}/.login_signal",
    "output/{domain}/.login_status.json"
  ],
  "failure_modes": [
    "invalid_credentials",
    "mfa_required",
    "session_expired",
    "display_missing",
    "recorder_timeout",
    "browser_closed"
  ],
  "required_tests": [
    "happy_path",
    "error_path",
    "session_expiry_path",
    "evidence",
    "timeout_path",
    "cancel_path"
  ]
}
