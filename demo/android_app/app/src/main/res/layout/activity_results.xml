<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/results_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="検索結果"
        app:titleTextColor="@android:color/white" />

    <TextView
        android:id="@+id/results_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textSize="14sp"
        android:contentDescription="results_summary" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/results_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        android:contentDescription="results_tabs">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="おすすめ" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最安" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最速" />

    </com.google.android.material.tabs.TabLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/results_filter_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/results_filter_direct"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="直行のみ"
            android:contentDescription="results_filter_direct" />

        <com.google.android.material.chip.Chip
            android:id="@+id/results_filter_morning"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="午前発"
            android:contentDescription="results_filter_morning" />

        <com.google.android.material.chip.Chip
            android:id="@+id/results_filter_evening"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="夕方以降"
            android:contentDescription="results_filter_evening" />

    </com.google.android.material.chip.ChipGroup>

    <ScrollView
        android:id="@+id/results_list_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/results_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/results_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:contentDescription="results_empty">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="該当する便がありません"
            android:textSize="16sp" />

        <Button
            android:id="@+id/results_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="条件を変える"
            android:contentDescription="results_back" />

    </LinearLayout>

</LinearLayout>
