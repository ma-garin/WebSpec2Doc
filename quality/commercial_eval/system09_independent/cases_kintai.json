  {
   "title": "残業の月上限の引き下げ",
   "change_text": "残業の月上限を45時間から36時間に引き下げる。",
   "expected_items": [
    "REQ-103",
    "DSN-104",
    "SCR-304",
    "SCR-353",
    "TC-106"
   ]
  },
  {
   "title": "長時間残業の割増率の変更",
   "change_text": "月60時間を超えた残業の割増を1.5倍から1.75倍にする。",
   "expected_items": [
    "REQ-105",
    "DSN-106",
    "SCR-357",
    "TC-109"
   ]
  },
  {
   "title": "休日出勤の割増率の変更",
   "change_text": "日曜など法定休日に働いた分の割増を1.35倍から1.5倍に引き上げる。",
   "expected_items": [
    "REQ-106",
    "DSN-106",
    "SCR-357",
    "TC-110"
   ]
  },
  {
   "title": "深夜時間帯の開始前倒し",
