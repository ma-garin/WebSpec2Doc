 "cases": [
  {
   "title": "確定ボタンの文言変更",
   "change_text": "成績確定画面のボタンの文言を、「確定する」から「確定を申請する」に変える。",
   "expected_items": [
    "SCR-622"
   ]
  },
  {
   "title": "補習表示と再試験欄の見せ方",
   "change_text": "教員の入力表で、「補習対象」の表示を行の端のラベルから素点の横のアイコンに変える。あわせて、再試験の結果入力欄を行の末尾に固定する。",
   "expected_items": [
    "SCR-604",
    "SCR-605"
   ]
  },
  {
   "title": "確定者と承認者の変更",
   "change_text": "成績を確認して確定する役を学年主任から教務主任に変え、確定後の修正を承認する役を教務主任から校長に変える。",
   "expected_items": [
    "REQ-409",
    "DSN-409",
    "DSN-416",
    "SCR-607",
    "TC-413"
   ]
  },
  {
   "title": "評定の段階の細分化",
   "change_text": "評定を5段階から10段階にし、各段階の点数の幅を10点ずつに等分する。",
   "expected_items": [
    "REQ-403",
    "REQ-407",
    "REQ-412",
    "DSN-403",
    "DSN-407",
    "DSN-412",
    "SCR-603",
    "SCR-620",
    "SCR-621",
    "TC-403",
    "TC-404",
    "TC-410",
    "TC-417",
    "TC-418"
   ]
  },
  {
   "title": "評定の下限点の引き下げ",
   "change_text": "評定3の下限を65点から60点に、評定2の下限を50点から45点に下げる。",
   "expected_items": [
    "REQ-403",
    "REQ-407",
    "DSN-403",
    "DSN-407",
    "TC-404"
   ]
  },
  {
   "title": "履修認定の欠席基準の厳格化",
   "change_text": "履修を認定しない欠席の基準を、授業時数の3分の1超から4分の1超に厳しくする。",
   "expected_items": [
    "REQ-406",
    "DSN-406",
    "SCR-606",
    "TC-408"
   ]
  },
  {
   "title": "赤点の基準の引き上げ",
   "change_text": "赤点の基準を、定期試験の素点30点未満から40点未満に引き上げる。",
   "expected_items": [
    "REQ-404",
    "DSN-404",
    "TC-405"
   ]
  },
  {
   "title": "所見欄の表示行数の変更",
   "change_text": "所見の文字数の上限は変えずに、通知表のプレビューの所見欄を3行表示から5行表示にする。",
   "expected_items": [
    "SCR-624"
   ]
  },
  {
   "title": "進級保留の条件の変更",
   "change_text": "進級の保留は、学年評定が1の科目が3科目以上ある場合に限り、出席不足による保留は教務主任が認めた場合だけにする。",
   "expected_items": [
    "REQ-412",
    "DSN-412",
    "SCR-621"
   ]
  },
  {
   "title": "成績入力期限の短縮",
   "change_text": "成績の入力の期限を、試験日から10日以内から5日以内に短縮する。",
   "expected_items": [
    "REQ-408",
    "DSN-408",
    "SCR-602",
    "TC-412"
   ]
  },
  {
   "title": "集計対象外の人数の引き上げ",
   "change_text": "DSN-414 の、集計を表示しないクラスの人数を、5人未満から10人未満に引き上げる。",
   "expected_items": [
    "DSN-414",
    "SCR-608"
   ]
  },
  {
   "title": "再試験の素点上限の引き上げ",
   "change_text": "再試験に合格した場合の素点の上限を、60点から70点に引き上げる。",
   "expected_items": [
    "REQ-405",
    "DSN-405",
    "SCR-605",
    "TC-407"
   ]
  },
  {
   "title": "県教委提出CSVの文字コード変更",
   "change_text": "県の教育委員会へ出すCSVの文字コードを、UTF-8からShift_JISに変える。通知表の出力は変えない。",
   "expected_items": [
    "REQ-416",
    "DSN-415",
    "TC-422"
   ]
  }
 ]
